# raw FDTDX phasor dumps are large (tens of MB per run); the derived deliverables (spectra, normalized fields at the
# analysis wavelengths, U(z), multipoles, figures, metadata) are committed instead
*/*/phasors.npz
reference/*/phasors.npz
__pycache__/
# superseded thin-glass configuration: keep only the metadata and spectra for the record
*_superseded/*
!*_superseded/run_meta.json
!*_superseded/spectra_prod.csv
!*_superseded/spectra_prod.png
