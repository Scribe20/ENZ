__pycache__/
*.pyc

# FDTDX raw detector dumps and segment-resume checkpoints.  phasors.npz is the raw per-detector output
# (~130 MB) that post-processing turns into the spectra files, and state.npz (~220 MB) is the resume
# checkpoint, regenerated by the run and meaningless once it completes.  Neither has ever been tracked;
# what is committed is the derived spectra, run_meta.json and the comparison outputs.
enz_jz_inverse_design/fdtdx_four_finalists/*/*/phasors.npz
enz_jz_inverse_design/fdtdx_four_finalists/*/*/state.npz
enz_jz_inverse_design/fdtdx_four_finalists/*/*/*.tmp.npz
enz_jz_inverse_design/fdtdx_four_finalists/.jaxcache/
